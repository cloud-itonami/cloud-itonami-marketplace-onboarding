{:itonami.blueprint/id "cloud-itonami-marketplace-onboarding"
 :itonami.blueprint/name "Federated Marketplace Seller Onboarding"
 :itonami.blueprint/domain :marketplace/seller-onboarding
 :itonami.blueprint/license "AGPL-3.0-or-later"
 :itonami.blueprint/social-impact [:small-seller-access :data-sovereignty :consumer-protection]
 :itonami.blueprint/governor :seller-onboarding-governor
 :itonami.blueprint/robotics false
 :itonami.blueprint/required-technologies [:identity :forms :audit-ledger :ekyc :aml]
 :itonami.blueprint/optional-technologies []
 :itonami.blueprint/status :public-oss
 :itonami.blueprint/maturity :implemented
 ;; Function-keyed rather than taxonomy-keyed, following the
 ;; cloud-itonami-gtin-* precedent (ADR-2607031800): a marketplace is not
 ;; an ISIC/ISCO class. Design record: ADR-2607264000.
 :itonami.blueprint/keying :function
 :itonami.blueprint/adr "2607264000-marketplace-federated-commerce-layer"
 ;; Address added 2026-07-30. The Worker is deployed and /health answers 200.
 ;; It is a *.workers.dev URL because this Worker declares neither a route nor
 ;; a custom_domain, and no marketplace./api. host under itonami.cloud resolves
 ;; — so this is the only real address, recorded as such rather than as a
 ;; preferred one. :endpoint-kind is what a consumer should key off if it wants
 ;; to treat a provisional address differently.
 :itonami.blueprint/endpoint "https://cloud-itonami-marketplace-onboarding.04-feasts-minded.workers.dev"
 :itonami.blueprint/endpoint-kind :workers-dev
 ;; This Worker answers /health with a JSON body carrying service, store,
 ;; auth model and DID. Declared rather than assumed: a consumer must not
 ;; guess a probe path, because guessing wrong reads an SPA index as a
 ;; healthy API.
 :itonami.blueprint/health-path "/health"}
